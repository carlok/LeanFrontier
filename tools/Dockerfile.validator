FROM debian:bookworm-slim

# The receiver needs only Python's standard library. Validator code always comes
# from the separate trusted checkout, never from the pull-request candidate.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git python3 \
    && rm -rf /var/lib/apt/lists/*

# The workflow mounts this directory read-write only while acquiring the pinned
# toolchain, then read-only while building and auditing an untrusted candidate.
ENV ELAN_HOME=/elan
ENV PATH="/elan/bin:${PATH}"
RUN curl --fail --show-error --silent --location https://elan.lean-lang.org/elan-init.sh \
    | sh -s -- -y --default-toolchain none

ENV PYTHONDONTWRITEBYTECODE=1
